local PlayerListLayout = Instance.new("UIListLayout");
PlayerListLayout.Padding = UDim.new(0, 4);
PlayerListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center;
PlayerListLayout.Parent = PlayerScroll;
local function rebuildPlayerListGUI()
	for _, child in pairs(PlayerScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy();
		end
	end
	local players = {};
	for _, plr in ipairs(Players:GetPlayers()) do
		if (plr ~= LocalPlayer) then
			table.insert(players, plr);
		end
	end
	table.sort(players, function(a, b)
		return a.DisplayName:lower() < b.DisplayName:lower();
	end);
	for _, plr in ipairs(players) do
		local currentMode = GetPlayerMode(plr.Name);
		local row = Instance.new("Frame");
		row.Size = UDim2.new(1, 0, 0, 42);
		row.BackgroundColor3 = Color3.fromRGB(22, 22, 30);
		row.Parent = PlayerScroll;
		local rowCorner = Instance.new("UICorner");
		rowCorner.CornerRadius = UDim.new(0, 6);
		rowCorner.Parent = row;
		local nameLabel = Instance.new("TextLabel");
		nameLabel.Size = UDim2.new(0, 180, 1, 0);
		nameLabel.Position = UDim2.new(0, 12, 0, 0);
		nameLabel.BackgroundTransparency = 1;
		nameLabel.Text = plr.DisplayName;
		nameLabel.TextColor3 = MODE_COLORS[currentMode + 1];
		nameLabel.Font = Enum.Font.GothamBold;
		nameLabel.TextSize = 12;
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left;
		nameLabel.Parent = row;
		local neutralBtn = Instance.new("TextButton");
		neutralBtn.Size = UDim2.new(0, 105, 0, 30);
		neutralBtn.Position = UDim2.new(0, 200, 0.5, -15);
		neutralBtn.BackgroundColor3 = MODE_COLORS[MODE_OFF + 1];
		neutralBtn.Text = "Neutral";
		neutralBtn.TextColor3 = Color3.new(1, 1, 1);
		neutralBtn.Font = Enum.Font.GothamBold;
		neutralBtn.TextSize = 10;
		neutralBtn.Parent = row;
		Instance.new("UICorner", neutralBtn).CornerRadius = UDim.new(0, 4);
		local autoBtn = Instance.new("TextButton");
		autoBtn.Size = UDim2.new(0, 105, 0, 30);
		autoBtn.Position = UDim2.new(0, 315, 0.5, -15);
		autoBtn.BackgroundColor3 = MODE_COLORS[MODE_AUTOSHOOT + 1];
		autoBtn.Text = "Autoshot";
		autoBtn.TextColor3 = Color3.new(1, 1, 1);
		autoBtn.Font = Enum.Font.GothamBold;
		autoBtn.TextSize = 10;
		autoBtn.Parent = row;
		Instance.new("UICorner", autoBtn).CornerRadius = UDim.new(0, 4);
		local trigBtn = Instance.new("TextButton");
		trigBtn.Size = UDim2.new(0, 105, 0, 30);
		trigBtn.Position = UDim2.new(0, 430, 0.5, -15);
		trigBtn.BackgroundColor3 = MODE_COLORS[MODE_TRIGGER + 1];
		trigBtn.Text = "Trigger";
		trigBtn.TextColor3 = Color3.new(1, 1, 1);
		trigBtn.Font = Enum.Font.GothamBold;
		trigBtn.TextSize = 10;
		trigBtn.Parent = row;
		Instance.new("UICorner", trigBtn).CornerRadius = UDim.new(0, 4);
		if (currentMode == MODE_OFF) then
			neutralBtn.BackgroundColor3 = MODE_COLORS[MODE_OFF + 1]:Lerp(Color3.new(1, 1, 1), 0.35);
			neutralBtn.Text = "▶ Neutral";
		elseif (currentMode == MODE_AUTOSHOOT) then
			autoBtn.BackgroundColor3 = MODE_COLORS[MODE_AUTOSHOOT + 1]:Lerp(Color3.new(1, 1, 1), 0.35);
			autoBtn.Text = "▶ Autoshot";
		elseif (currentMode == MODE_TRIGGER) then
			trigBtn.BackgroundColor3 = MODE_COLORS[MODE_TRIGGER + 1]:Lerp(Color3.new(1, 1, 1), 0.35);
			trigBtn.Text = "▶ Trigger";
		end
		local function updateUIMode(newMode)
			currentMode = newMode;
			SetPlayerMode(plr.Name, newMode);
			nameLabel.TextColor3 = MODE_COLORS[newMode + 1];
			neutralBtn.BackgroundColor3 = MODE_COLORS[MODE_OFF + 1];
			neutralBtn.Text = "Neutral";
			autoBtn.BackgroundColor3 = MODE_COLORS[MODE_AUTOSHOOT + 1];
			autoBtn.Text = "Autoshot";
			trigBtn.BackgroundColor3 = MODE_COLORS[MODE_TRIGGER + 1];
			trigBtn.Text = "Trigger";
			if (newMode == MODE_OFF) then
				neutralBtn.BackgroundColor3 = MODE_COLORS[MODE_OFF + 1]:Lerp(Color3.new(1, 1, 1), 0.35);
				neutralBtn.Text = "▶ Neutral";
			elseif (newMode == MODE_AUTOSHOOT) then
				autoBtn.BackgroundColor3 = MODE_COLORS[MODE_AUTOSHOOT + 1]:Lerp(Color3.new(1, 1, 1), 0.35);
				autoBtn.Text = "▶ Autoshot";
			elseif (newMode == MODE_TRIGGER) then
				trigBtn.BackgroundColor3 = MODE_COLORS[MODE_TRIGGER + 1]:Lerp(Color3.new(1, 1, 1), 0.35);
				trigBtn.Text = "▶ Trigger";
			end
		end
		neutralBtn.MouseButton1Click:Connect(function()
			updateUIMode(MODE_OFF);
		end);
		autoBtn.MouseButton1Click:Connect(function()
			updateUIMode(MODE_AUTOSHOOT);
		end);
		trigBtn.MouseButton1Click:Connect(function()
			updateUIMode(MODE_TRIGGER);
		end);
	end
end
