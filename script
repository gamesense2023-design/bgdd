local function getDistanceBetweenPlayers(targetPlayer)
	local localChar = LocalPlayer.Character;
	local targetChar = targetPlayer.Character;
	if (not localChar or not targetChar) then
		return math.huge;
	end
	local localPart = getPrimaryPart(localChar);
	local targetPart = getPrimaryPart(targetChar);
	if (not localPart or not targetPart) then
		return math.huge;
	end
	return (localPart.Position - targetPart.Position).Magnitude;
end
local function updateChamsForPlayer(player)
	if not Config.Esp.Chams then
		local char = player.Character;
		if char then
			local existing = char:FindFirstChild("emoline_Chams");
			if existing then
				existing:Destroy();
			end
		end
		return;
	end
	local char = player.Character;
	if not char then
		return;
	end
	local dist = getDistanceBetweenPlayers(player);
	if (dist > Config.Esp.MaxDist) then
		local existing = char:FindFirstChild("emoline_Chams");
		if existing then
			existing:Destroy();
		end
		return;
	end
	if not char:FindFirstChild("emoline_Chams") then
		local highlight = Instance.new("Highlight");
		highlight.Name = "emoline_Chams";
		highlight.FillColor = Config.Esp.ChamsColor;
		highlight.FillTransparency = Config.Esp.ChamsTransparency;
		highlight.OutlineColor = Config.Esp.ChamsColor;
		highlight.Parent = char;
	else
		local hl = char:FindFirstChild("emoline_Chams");
		hl.FillColor = Config.Esp.ChamsColor;
		hl.FillTransparency = Config.Esp.ChamsTransparency;
		hl.OutlineColor = Config.Esp.ChamsColor;
