local drawingSupported = pcall(function()
	local d = Drawing.new("Text");
	d:Remove();
end);
if drawingSupported then
	RunService.RenderStepped:Connect(function()
		if not Config.Esp.Name then
			for _, objTable in pairs(espObjects) do
				if objTable.name then
					objTable.name.Visible = false;
				end
			end
			return;
		end
		local camera = workspace.CurrentCamera;
		if not camera then
			return;
		end
		for _, plr in pairs(Players:GetPlayers()) do
			if (plr == LocalPlayer) then
				continue;
			end
			if (not isAlive(plr) or isKnockedOut(plr)) then
				if (espObjects[plr] and espObjects[plr].name) then
					espObjects[plr].name.Visible = false;
				end
				continue;
			end
			local char = plr.Character;
			if not char then
				continue;
			end
			local head = char:FindFirstChild("Head");
			if not head then
				continue;
			end
			local dist = getDistanceBetweenPlayers(plr);
			if (dist > Config.Esp.MaxDist) then
				if (espObjects[plr] and espObjects[plr].name) then
					espObjects[plr].name.Visible = false;
				end
				continue;
			end
			local headScreen, onScreen = camera:WorldToViewportPoint(head.Position);
			if not onScreen then
				if (espObjects[plr] and espObjects[plr].name) then
					espObjects[plr].name.Visible = false;
				end
				continue;
			end
			if not espObjects[plr] then
				espObjects[plr] = {};
			end
			if Config.Esp.Name then
				if not espObjects[plr].name then
					espObjects[plr].name = Drawing.new("Text");
					espObjects[plr].name.Size = 12;
					espObjects[plr].name.Center = true;
					espObjects[plr].name.Outline = true;
				end
				espObjects[plr].name.Visible = true;
				espObjects[plr].name.Text = plr.DisplayName;
				espObjects[plr].name.Position = Vector2.new(headScreen.X, headScreen.Y - 25);
				espObjects[plr].name.Color = Color3.new(1, 1, 1);
			elseif espObjects[plr].name then
				espObjects[plr].name.Visible = false;
			end
		end
		for plr, objTable in pairs(espObjects) do
			if (not plr or not plr.Parent) then
				if objTable.name then
					objTable.name:Remove();
				end
				espObjects[plr] = nil;
			end
		end
	end);
end
