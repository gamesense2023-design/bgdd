		local specDataRemote = AdminRemotes:FindFirstChild("SpecData");
		if (specDataRemote and specDataRemote:IsA("RemoteEvent")) then
			specDataRemote.OnClientEvent:Connect(function()
				setSpectatingState(true);
			end);
		end
	end
	
	while task.wait(1) do
