-- [FIX] Функция восстановления оригинального размера хитбокса
local function RestoreOriginalSize(part, playerName)
	if originalHitboxSizes[playerName] then
		part.Size = originalHitboxSizes[playerName];
		part.Transparency = 1;
		part.Material = Enum.Material.Plastic;
		part.Color = Color3.new(1, 1, 1);
	end
end

-- [FIX] Улучшенный Heartbeat для хитбоксов с мгновенным восстановлением
RunService.Heartbeat:Connect(function()
	local sizeX = Config.Hitbox.SizeX;
	local sizeY = Config.Hitbox.SizeY;
	local sizeZ = Config.Hitbox.SizeZ;
	local trans = Config.Hitbox.Transparency;
	local color = Color3.fromRGB(Config.Hitbox.R, Config.Hitbox.G, Config.Hitbox.B);
	
	for _, p in pairs(Players:GetPlayers()) do
		if (p == LocalPlayer) then continue; end
		local char = p.Character;
		if not char then continue; end
		local part = getPrimaryPart(char);
		if not part then continue; end
		
		-- Сохраняем оригинальный размер при первой встрече
		if not originalHitboxSizes[p.Name] then
			originalHitboxSizes[p.Name] = part.Size;
		end
		
		part.CanCollide = false;
		
		if not Config.Hitbox.Active then
			RestoreOriginalSize(part, p.Name);
			continue;
		end
		
		local mode = GetPlayerMode(p.Name);
		local isDead = not isAlive(p);
		local knocked = isKnockedOut(p);
		local shouldExpand = ((mode == MODE_AUTOSHOOT) or (mode == MODE_TRIGGER)) and not isDead and not knocked;
		
		if knocked then
			part.Size = Vector3.new(0.01, 0.01, 0.01);
			part.Transparency = 1;
			part.Material = Enum.Material.Plastic;
			part.Color = Color3.new(1, 1, 1);
		elseif shouldExpand then
			part.Size = Vector3.new(sizeX, sizeY, sizeZ);
			part.Transparency = trans;
			part.Color = color;
			part.Material = Enum.Material.ForceField;
		else
			RestoreOriginalSize(part, p.Name);
		end
	end
end);

