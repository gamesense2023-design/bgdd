-- ===== NoSpread: Boom Hood использует RandomBulletOffsets/CustomOffsets в Config =====
local NoSpreadOriginal = nil;

local function SnapshotNoSpreadConfig()
	if NoSpreadOriginal then return; end
	pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage");
		local modules = ReplicatedStorage:FindFirstChild("Modules");
		if not modules then return; end
		local gunModuleFolder = modules:FindFirstChild("GunModule");
		if not gunModuleFolder then return; end
		local configModule = gunModuleFolder:FindFirstChild("Config");
		if not (configModule and configModule:IsA("ModuleScript")) then return; end
		local okReq, gunConfig = pcall(require, configModule);
		if (not okReq) or (type(gunConfig) ~= "table") then return; end
		local okClone, freshConfig = pcall(require, configModule:Clone());
		if (not okClone) or (type(freshConfig) ~= "table") then freshConfig = gunConfig; end
		NoSpreadOriginal = {_recoil = _G.Recoil};
		for gunName, fresh in pairs(freshConfig) do
			if (type(fresh) == "table") then
				local orig = {};
				if (type(fresh.RandomBulletOffsets) == "table") then
					orig.RandomBulletOffsets = {};
					for i, set in pairs(fresh.RandomBulletOffsets) do
						if (type(set) == "table") then
							local copied = {};
							for j, vec in pairs(set) do
								copied[j] = vec;
							end
							orig.RandomBulletOffsets[i] = copied;
						end
					end
				end
				if (type(fresh.CustomOffsets) == "table") then
					orig.CustomOffsets = {};
					for j, vec in pairs(fresh.CustomOffsets) do
						orig.CustomOffsets[j] = vec;
					end
				end
				NoSpreadOriginal[gunName] = orig;
			end
		end
	end);
end

local function RandomizeNoSpread()
	local minPct = math.clamp(Config.Utility.SpreadMin or 0, 0, 100) / 100;
	local maxPct = math.clamp(Config.Utility.SpreadMax or 0, 0, 100) / 100;
	if (minPct > maxPct) then
		minPct, maxPct = maxPct, minPct;
	end
	SnapshotNoSpreadConfig();
	pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage");
		local modules = ReplicatedStorage:FindFirstChild("Modules");
		if not modules then return; end
		local gunModuleFolder = modules:FindFirstChild("GunModule");
		if not gunModuleFolder then return; end
		local configModule = gunModuleFolder:FindFirstChild("Config");
		if not (configModule and configModule:IsA("ModuleScript")) then return; end
		local okReq, gunConfig = pcall(require, configModule);
		if (not okReq) or (type(gunConfig) ~= "table") then return; end
		local doneTables = {};
		for gunName, orig in pairs(NoSpreadOriginal or {}) do
			local cfg = gunConfig[gunName];
			if (type(cfg) ~= "table" or type(orig) ~= "table") then continue; end
			if (type(cfg.RandomBulletOffsets) == "table" and type(orig.RandomBulletOffsets) == "table" and not doneTables[cfg.RandomBulletOffsets]) then
				doneTables[cfg.RandomBulletOffsets] = true;
				for i, set in pairs(cfg.RandomBulletOffsets) do
					local origSet = orig.RandomBulletOffsets[i];
					if (type(set) == "table" and type(origSet) == "table") then
						local factor = minPct + ((maxPct - minPct) * math.random());
						for j, vec in pairs(set) do
							local base = (typeof(origSet[j]) == "Vector3" and origSet[j]) or vec;
							if typeof(base) == "Vector3" then
								set[j] = base * factor;
							end
						end
					end
				end
			end
			if (type(cfg.CustomOffsets) == "table" and type(orig.CustomOffsets) == "table" and not doneTables[cfg.CustomOffsets]) then
				doneTables[cfg.CustomOffsets] = true;
				local factor = minPct + ((maxPct - minPct) * math.random());
				for j, vec in pairs(cfg.CustomOffsets) do
					local base = (typeof(orig.CustomOffsets[j]) == "Vector3" and orig.CustomOffsets[j]) or vec;
					if typeof(base) == "Vector3" then
						cfg.CustomOffsets[j] = base * factor;
					end
				end
			end
		end
	end);
end

local function RestoreNoSpread()
	pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage");
		local modules = ReplicatedStorage:FindFirstChild("Modules");
		if not modules then return; end
		local gunModuleFolder = modules:FindFirstChild("GunModule");
		if not gunModuleFolder then return; end
		local configModule = gunModuleFolder:FindFirstChild("Config");
		if not (configModule and configModule:IsA("ModuleScript")) then return; end
		local okReq, gunConfig = pcall(require, configModule);
		if (not okReq) or (type(gunConfig) ~= "table") then return; end
		for gunName, orig in pairs(NoSpreadOriginal or {}) do
			local cfg = gunConfig[gunName];
			if (type(cfg) ~= "table" or type(orig) ~= "table") then continue; end
			if (type(cfg.RandomBulletOffsets) == "table" and type(orig.RandomBulletOffsets) == "table") then
				for i, set in pairs(cfg.RandomBulletOffsets) do
					local origSet = orig.RandomBulletOffsets[i];
					if (type(set) == "table" and type(origSet) == "table") then
						for j in pairs(set) do
							set[j] = origSet[j];
						end
					end
				end
			end
			if (type(cfg.CustomOffsets) == "table" and type(orig.CustomOffsets) == "table") then
				for j in pairs(cfg.CustomOffsets) do
					cfg.CustomOffsets[j] = orig.CustomOffsets[j];
				end
			end
		end
	end);
end

local function applyNoSpreadAll()
	if Config.Utility.NoSpread then
		SnapshotNoSpreadConfig();
		RandomizeNoSpread();
		_G.Recoil = false;
		pcall(function()
			if LocalPlayer.Backpack then
				for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
					applyNoSpreadToTool(tool);
				end
			end
			if LocalPlayer.Character then
				for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
					applyNoSpreadToTool(tool);
				end
			end
		end);
	else
		RestoreNoSpread();
		if (NoSpreadOriginal and NoSpreadOriginal._recoil ~= nil) then
			_G.Recoil = NoSpreadOriginal._recoil;
		end
	end
end

